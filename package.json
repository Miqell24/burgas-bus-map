{
  "name": "burgas-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Burgas public transport (26 bus + trolleybus T1) — GTFS synthesised from the Burgasbus journey planner + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "feed": "node pipeline/burgas-feed.mjs",
    "build": "node --max-old-space-size=4096 pipeline/build.mjs --all",
    "lines": "node --max-old-space-size=4096 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=4096 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8176"
  }
}
